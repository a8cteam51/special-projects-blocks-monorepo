{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpcomsp/dynamic-table-of-contents",
	"version": "0.1.9",
	"title": "Dynamic Table of Contents",
	"category": "design",
	"description": "Creates a table of contents that's dynamically (PHP) rendered.",
	"example": {},
	"supports": {
		"html": false,
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true
		},
		"position": {
			"sticky": true
		},
		"__experimentalBorder": {
			"width": true,
			"radius": true,
			"color": true
		}
	},
	"usesContext": [ "postId" ],
	"attributes": {
		"title": {
			"type": "string",
			"default": "Table of Contents"
		},
		"includeH1": {
			"type": "boolean",
			"default": true
		},
		"includeH2": {
			"type": "boolean",
			"default": true
		},
		"includeH3": {
			"type": "boolean",
			"default": true
		},
		"includeH4": {
			"type": "boolean",
			"default": true
		},
		"includeH5": {
			"type": "boolean",
			"default": true
		},
		"includeH6": {
			"type": "boolean",
			"default": true
		}
	},
	"textdomain": "dynamic-table-of-contents",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
