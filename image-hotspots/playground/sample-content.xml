	<item>
		<title><![CDATA[Image Hotspots]]></title>
		<dc:creator><![CDATA[admin]]></dc:creator>
		<content:encoded><![CDATA[<!-- wp:paragraph -->
<p>Select a marker on the photo to open its card. Press Escape, or click outside the card, to close it. Markers are buttons, so you can also reach them with the Tab key.</p>
<!-- /wp:paragraph -->

<!-- wp:a8csp/image-hotspots {"id":2001,"url":"https://example.com/wp-content/uploads/playground/parthenon-square.webp","alt":"The front of the Parthenon in Athens: a row of columns under the remains of a pediment","sizeSlug":"full"} -->
<!-- wp:a8csp/image-hotspot {"x":52,"y":23,"label":"Pediment"} -->
<!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading">Pediment</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>The triangular gable at each end of the roof. Both pediments once held large groups of sculpture.</p>
<!-- /wp:paragraph -->
<!-- /wp:a8csp/image-hotspot -->

<!-- wp:a8csp/image-hotspot {"x":76,"y":34,"label":"Entablature"} -->
<!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading">Entablature</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>The horizontal band that rests on the columns: the architrave, then the frieze, then the cornice.</p>
<!-- /wp:paragraph -->
<!-- /wp:a8csp/image-hotspot -->

<!-- wp:a8csp/image-hotspot {"x":63.5,"y":58,"label":"Doric columns"} -->
<!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading">Doric columns</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Fluted columns with plain capitals and no bases. They swell slightly towards the middle.</p>
<!-- /wp:paragraph -->
<!-- /wp:a8csp/image-hotspot -->

<!-- wp:a8csp/image-hotspot {"x":38,"y":68,"label":"Stylobate"} -->
<!-- wp:heading {"level":3} -->
<h3 class="wp-block-heading">Stylobate</h3>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>The top step of the platform, on which the columns stand.</p>
<!-- /wp:paragraph -->
<!-- /wp:a8csp/image-hotspot -->
<!-- /wp:a8csp/image-hotspots -->]]></content:encoded>
