<!-- /wp:heading -->

<!-- wp:paragraph {"align":"wide","fontSize":"small"} -->
<p class="alignwide has-small-font-size">This section is a Related Posts Query block in the single post template. Jetpack is not installed in this demo, so the block falls back to recent posts, shuffled on each page load.</p>
<!-- /wp:paragraph -->

<!-- wp:query {"query":{"perPage":3,"inherit":false,"postType":"post"},"namespace":"a8csp-jrpql/related-posts","align":"wide"} -->
