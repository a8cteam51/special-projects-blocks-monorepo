{
	"name": "featured-video",
	"version": "0.3.0",
	"description": "Add the ability to use Featured Video inplace of Featured Image.",
	"author": "Automattic Special Projects Team",
	"license": "GPL-2.0-or-later",
	"scripts": {
		"build": "wp-scripts build src/editor --output-path=build/editor && wp-scripts build src/view --output-path=build/view",
		"build:editor": "wp-scripts build src/editor --output-path=build/editor",
		"build:view": "wp-scripts build src/view --output-path=build/view",
		"format": "wp-scripts format",
		"lint:css": "wp-scripts lint-style",
		"lint:js": "wp-scripts lint-js",
		"packages-update": "wp-scripts packages-update",
		"plugin-zip": "wp-scripts plugin-zip",
		"start": "wp-scripts start src/editor --output-path=build/editor",
		"start:view": "wp-scripts start src/view --output-path=build/view"
	},
	"devDependencies": {
		"@wordpress/scripts": "^31.0.0",
		"@wordpress/browserslist-config": "^6.35.0"
	}
}
