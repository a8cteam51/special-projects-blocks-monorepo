{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Sibling Pages List",
		"description": "A parent page with four child pages; each child shows a Sibling Pages List that links to the other children, with the current page as plain text.",
		"author": "WordPress Special Projects Team",
		"categories": [ "Block" ]
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"login": true,
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/a8cteam51/special-projects-blocks-monorepo/releases/download/sibling-pages-list%400.1.2/sibling-pages-list.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installTheme",
			"themeData": {
				"resource": "wordpress.org/themes",
				"slug": "twentytwentyfive"
			},
			"ifAlreadyInstalled": "skip",
			"options": {
				"activate": true
			}
		},
		{
			"step": "importWxr",
			"file": {
				"resource": "bundled",
				"path": "sample-content.xml"
			}
		},
		{
			"step": "setSiteOptions",
			"options": {
				"show_on_front": "page",
				"page_on_front": "1001"
			}
		}
	]
}
