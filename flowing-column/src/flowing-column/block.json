{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "a8csp/flowing-column",
	"version": "0.2.1",
	"title": "Flowing Column",
	"category": "design",
	"icon": "columns",
	"description": "A block that allows you to create a flowing column layout, like a newspaper.",
	"example": {},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [
			"wide",
			"full"
		],
		"spacing": {
			"blockGap": [
				"horizontal"
			],
			"margin": true,
			"padding": true,
			"units": [
				"px",
				"em",
				"rem",
				"vh",
				"vw",
				"%"
			]
		},
		"color": {
			"background": true,
			"text": true,
			"gradients": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"textAlign": true,
			"fontFamily": true,
			"fontStyle": true,
			"fontWeight": true,
			"letterSpacing": true,
			"textDecoration": true,
			"textTransform": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"dimensions": {
			"minHeight": true
		}
	},
	"attributes": {
		"columnCount": {
			"type": "number",
			"minimum": 0,
			"default": 2
		},
		"columnMinWidth": {
			"type": "string",
			"default": "200px"
		},
		"columnRuleStyle": {
			"type": "string",
			"enum": [
				"none",
				"solid",
				"dashed",
				"dotted",
				"double",
				"groove",
				"ridge",
				"inset",
				"outset"
			],
			"default": "solid"
		},
		"columnRuleWidth": {
			"type": "string",
			"default": "1px"
		},
		"columnRuleColor": {
			"type": "string"
		},
		"customColumnRuleColor": {
			"type": "string"
		}
	},
	"textdomain": "flowing-column",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css"
}