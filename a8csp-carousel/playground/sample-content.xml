<!-- wp:post-featured-image {"isLink":true,"aspectRatio":"1","width":"260px","style":{"spacing":{"margin":{"right":"var:preset|spacing|30"}}}} /-->

<!-- wp:post-title {"level":3,"isLink":true,"fontSize":"medium"} /-->
<!-- /wp:post-template --></div>
<!-- /wp:query -->

<!-- wp:a8csp/carousel-pagination {"layout":{"type":"flex","justifyContent":"center"},"count":4} -->
<div aria-label="Slide controls" role="group" style="--button-size:24px" class="wp-block-a8csp-carousel-pagination"><button class="wp-block-a8csp-carousel-pagination--button"><span class="screen-reader-text">Slide 1 of 4</span></button><button class="wp-block-a8csp-carousel-pagination--button"><span class="screen-reader-text">Slide 2 of 4</span></button><button class="wp-block-a8csp-carousel-pagination--button"><span class="screen-reader-text">Slide 3 of 4</span></button><button class="wp-block-a8csp-carousel-pagination--button"><span class="screen-reader-text">Slide 4 of 4</span></button></div>
<!-- /wp:a8csp/carousel-pagination --></div>
<!-- /wp:a8csp/carousel -->]]></content:encoded>
