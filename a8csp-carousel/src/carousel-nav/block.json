{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "a8csp/carousel-nav",
	"version": "1.2.0",
	"title": "Carousel Navigation",
	"category": "widgets",
	"icon": "controls-back",
	"description": "Display previous and next navigation buttons for a carousel.",
	"example": {},
	"attributes": {
		"layout": {
			"type": "object"
		},
		"buttonColors": {
			"type": "object",
			"default": {
				"background": "",
				"backgroundHover": "",
				"icon": "",
				"iconHover": ""
			}
		},
		"buttonSize": {
			"type": "number",
			"default": 48
		},
		"customIcon": {
			"type": "boolean",
			"default": false
		},
		"iconUpload": {
			"type": "object"
		},
		"iconSize": {
			"type": "number"
		}
	},
	"styles": [
		{ "name": "default", "label": "Default", "isDefault": true },
		{ "name": "sides", "label": "Either side" },
		{ "name": "column", "label": "Left column" }
	],
	"supports": {
		"align": true,
		"layout": {
			"allowSwitching": false,
			"allowInheriting": false,
			"default": {
				"type": "flex"
			}
		},
		"spacing": {
			"blockGap": [ "horizontal", "vertical" ],
			"margin": true,
			"padding": true,
			"__experimentalDefaultControls": {
				"blockGap": true
			}
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"width": true,
			"__experimentalSkipSerialization": true,
			"__experimentalDefaultControls": {
				"color": true,
				"radius": true,
				"width": true
			}
		}
	},
	"ancestor": [ "a8csp/carousel" ],
	"textdomain": "a8csp-carousel",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
