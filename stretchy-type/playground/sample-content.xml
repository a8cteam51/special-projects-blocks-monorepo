	<item>
		<title><![CDATA[Stretchy Type]]></title>
		<dc:creator><![CDATA[admin]]></dc:creator>
		<content:encoded><![CDATA[<!-- wp:paragraph -->
<p>Each Stretchy Type block scales one line of text so it exactly fills the width of its container. Resize the window to watch the text rescale, or open the page in the editor and type into any line.</p>
<!-- /wp:paragraph -->

<!-- wp:heading -->
<h2 class="wp-block-heading">Short and long lines</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>The same container width, so a short word is drawn much larger than a long sentence.</p>
<!-- /wp:paragraph -->

<!-- wp:group {"align":"wide","layout":{"type":"constrained","contentSize":"100%"}} -->
<div class="wp-block-group alignwide"><!-- wp:wpsp/stretchy-type {"viewBox":"0 0 94 29","style":{"typography":{"fontWeight":"700","textTransform":"uppercase"}}} -->
<svg viewBox="0 0 94 29" class="wp-block-wpsp-stretchy-type" style="font-weight:700;text-transform:uppercase"><foreignObject x="0" y="0" width="100%" height="100%"><span>Stretch</span></foreignObject></svg>
<!-- /wp:wpsp/stretchy-type -->

<!-- wp:wpsp/stretchy-type {"viewBox":"0 0 365 29"} -->
<svg viewBox="0 0 365 29" class="wp-block-wpsp-stretchy-type"><foreignObject x="0" y="0" width="100%" height="100%"><span>The longer the line, the smaller the type</span></foreignObject></svg>
<!-- /wp:wpsp/stretchy-type --></div>
<!-- /wp:group -->

<!-- wp:heading -->
<h2 class="wp-block-heading">Different container widths</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>In a two-thirds column and a one-third column, the same block settles at two different sizes.</p>
<!-- /wp:paragraph -->

<!-- wp:columns {"align":"wide"} -->
<div class="wp-block-columns alignwide"><!-- wp:column {"width":"66.66%"} -->
<div class="wp-block-column" style="flex-basis:66.66%"><!-- wp:wpsp/stretchy-type {"viewBox":"0 0 119 29"} -->
<svg viewBox="0 0 119 29" class="wp-block-wpsp-stretchy-type"><foreignObject x="0" y="0" width="100%" height="100%"><span>Wide column</span></foreignObject></svg>
<!-- /wp:wpsp/stretchy-type --></div>
<!-- /wp:column -->

<!-- wp:column {"width":"33.33%"} -->
<div class="wp-block-column" style="flex-basis:33.33%"><!-- wp:wpsp/stretchy-type {"viewBox":"0 0 138 29"} -->
<svg viewBox="0 0 138 29" class="wp-block-wpsp-stretchy-type"><foreignObject x="0" y="0" width="100%" height="100%"><span>Narrow column</span></foreignObject></svg>
<!-- /wp:wpsp/stretchy-type --></div>
<!-- /wp:column --></div>
<!-- /wp:columns -->

<!-- wp:heading -->
<h2 class="wp-block-heading">A stacked poster</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Lines of different lengths stacked in one group each fill the same width, with colour, font and letter-spacing settings from the block sidebar.</p>
<!-- /wp:paragraph -->

<!-- wp:group {"align":"wide","style":{"spacing":{"padding":{"top":"var:preset|spacing|50","bottom":"var:preset|spacing|50","left":"var:preset|spacing|50","right":"var:preset|spacing|50"},"blockGap":"0"}},"backgroundColor":"contrast","textColor":"base","layout":{"type":"constrained","contentSize":"100%"}} -->
<div class="wp-block-group alignwide has-base-color has-contrast-background-color has-text-color has-background" style="padding-top:var(--wp--preset--spacing--50);padding-right:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--50)"><!-- wp:wpsp/stretchy-type {"viewBox":"0 0 55 21","style":{"typography":{"fontWeight":"800","textTransform":"uppercase","letterSpacing":"-0.02em","lineHeight":"1"}}} -->
<svg viewBox="0 0 55 21" class="wp-block-wpsp-stretchy-type" style="font-weight:800;letter-spacing:-0.02em;line-height:1;text-transform:uppercase"><foreignObject x="0" y="0" width="100%" height="100%"><span>Open</span></foreignObject></svg>
<!-- /wp:wpsp/stretchy-type -->

<!-- wp:wpsp/stretchy-type {"viewBox":"0 0 149 21","style":{"typography":{"fontWeight":"300","lineHeight":"1"}},"textColor":"accent-1"} -->
<svg viewBox="0 0 149 21" class="wp-block-wpsp-stretchy-type has-accent-1-color has-text-color" style="font-weight:300;line-height:1"><foreignObject x="0" y="0" width="100%" height="100%"><span>Studio weekend</span></foreignObject></svg>
<!-- /wp:wpsp/stretchy-type -->

<!-- wp:wpsp/stretchy-type {"viewBox":"0 0 394 21","style":{"typography":{"lineHeight":"1"}},"fontFamily":"fira-code"} -->
<svg viewBox="0 0 394 21" class="wp-block-wpsp-stretchy-type has-fira-code-font-family" style="line-height:1"><foreignObject x="0" y="0" width="100%" height="100%"><span>Saturday and Sunday, 10am to 4pm</span></foreignObject></svg>
<!-- /wp:wpsp/stretchy-type --></div>
<!-- /wp:group -->]]></content:encoded>
