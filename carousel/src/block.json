{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpcomsp/carousel",
	"version": "0.1.0",
	"title": "Carousel",
	"category": "widgets",
	"icon": "slides",
	"description": "Display a horizontal series of content.",
	"example": {},
	"supports": {
		"color": {
			"background": true,
			"text": false
		},
		"html": false,
		"spacing": {
			"blockGap": true,
			"margin": true,
			"padding": true
		}
	},
	"attributes": {
		"animate": {
			"type": "string",
			"default": "one"
		},
		"animationSpeed": {
			"type": "number",
			"default": 0.3
		},
		"itemCount": {
			"type": "number",
			"default": 0
		},
		"overflow": {
			"type": "string",
			"default": "hidden",
			"enum": [ "hidden", "right", "left", "both" ]
		},
		"pagination": {
			"type": "boolean",
			"default": false
		},
		"prevNext": {
			"type": "boolean",
			"default": true
		},
		"prevNextPosition": {
			"type": "string",
			"default": "sides"
		},
		"title": {
			"type": "string"
		},
		"type": {
			"type": "string"
		}
	},
	"allowedBlocks": [
		"core/query",
		"core/gallery",
		"core/group",
		"woocommerce/product-collection"
	],
	"textdomain": "carousel",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScript": "file:./view.js"
}
