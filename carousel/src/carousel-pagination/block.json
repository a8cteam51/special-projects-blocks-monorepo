{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpcomsp/carousel-pagination",
	"version": "0.1.0",
	"title": "Carousel Pagination",
	"category": "widgets",
	"icon": "ellipsis",
	"description": "Display pagination buttons for a carousel.",
	"example": {},
	"attributes": {
		"layout": {
			"type": "object"
		},
		"buttonColors": {
			"type": "object",
			"default": {
				"background": ""
			}
		},
		"buttonSize": {
			"type": "number",
			"default": 24
		},
		"count": {
			"type": "number",
			"default": 0
		}
	},
	"supports": {
		"align": [ "wide", "full" ],
		"color": {
			"background": true,
			"text": false
		},
		"layout": {
			"allowSwitching": false,
			"allowInheriting": false,
			"default": {
				"type": "flex"
			}
		},
		"spacing": {
			"blockGap": [ "horizontal", "vertical" ],
			"margin": true,
			"padding": true,
			"__experimentalDefaultControls": {
				"blockGap": true
			}
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"width": true,
			"__experimentalSkipSerialization": true,
			"__experimentalDefaultControls": {
				"color": true,
				"radius": true,
				"width": true
			}
		}
	},
	"usesContext": [ "wpcomsp/item-count" ],
	"parent": [ "wpcomsp/carousel" ],
	"textdomain": "carousel",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
