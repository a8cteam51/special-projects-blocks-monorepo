{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "wpcomsp/videopress-download",
	"version": "0.1.0",
	"title": "Videopress Download",
	"category": "widgets",
	"icon": "download",
	"attributes": {
		"text": {
			"type": "string",
			"default": "Download"
		},
		"guid": {
			"type": "string",
			"default": ""
		},
		"src": {
			"type": "string",
			"default": ""
		},
		"allowDownload": {
			"type": "boolean",
			"default": true
		},
		"isPrivate": {
			"type": "boolean",
			"default": false
		}
	},
	"description": "Adds a Download button a VideoPress video in this post.",
	"supports": {
		"align": true,
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"color": {
			"background": true,
			"text": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"textAlign": true
		},
		"html": false,
		"interactivity": true
	},
	"textdomain": "videopress-download",
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"render": "file:./render.php",
	"viewScriptModule": "file:./view.js"
}
