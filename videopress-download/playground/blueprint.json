{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "VideoPress Download",
		"description": "Two public VideoPress videos played through the Jetpack VideoPress plugin without a WordPress.com connection, one with a working VideoPress Download button and one whose download setting is off, so its button is hidden; uploading, private videos and the VideoPress block's settings need a connected site.",
		"author": "WordPress Special Projects Team",
		"categories": [ "Block" ]
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"login": true,
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "jetpack-videopress"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/a8cteam51/special-projects-blocks-monorepo/releases/download/videopress-download%400.1.1/videopress-download.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installTheme",
			"themeData": {
				"resource": "wordpress.org/themes",
				"slug": "twentytwentyfive"
			},
			"ifAlreadyInstalled": "skip",
			"options": {
				"activate": true
			}
		},
		{
			"step": "importWxr",
			"file": {
				"resource": "bundled",
				"path": "sample-content.xml"
			}
		},
		{
			"step": "setSiteOptions",
			"options": {
				"show_on_front": "page",
				"page_on_front": "1001"
			}
		}
	]
}
