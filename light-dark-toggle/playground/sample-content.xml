  <item>
    <title><![CDATA[Header]]></title>
    <dc:creator><![CDATA[admin]]></dc:creator>
    <content:encoded><![CDATA[<!-- wp:group {"metadata":{"patternName":"twentytwentyfive/header","name":"Header","description":"Site header with site title and navigation.","categories":["header"]},"align":"full","layout":{"type":"default"}} -->
<div class="wp-block-group alignfull"><!-- wp:group {"layout":{"type":"constrained"}} -->
