  <item>
    <title><![CDATA[Custom Styles]]></title>
    <dc:creator><![CDATA[admin]]></dc:creator>
    <content:encoded><![CDATA[{"styles": {"css": "/* Dark mode for the Light Dark Toggle demo: the Light Dark Toggle block adds this class to the html element. */\nhtml.wpcomsp-light-dark-active {\n\tcolor-scheme: dark;\n\t--wp--preset--color--base: #111111;\n\t--wp--preset--color--contrast: #FFFFFF;\n\t--wp--preset--color--accent-4: #B4B4B4;\n\t--wp--preset--color--accent-5: #1E1E1E;\n}"}, "isGlobalStylesUserThemeJSON": true, "version": 3}]]></content:encoded>
