<!-- wp:wpcomsp/light-dark-toggle -->
<button class="wp-block-wpcomsp-light-dark-toggle mode-light" data-default-mode="light" aria-label="Switch to light mode"></button>
<!-- /wp:wpcomsp/light-dark-toggle --></div>
<!-- /wp:group --></div>
