	<item>
		<title><![CDATA[Cover Background Crossfade]]></title>
		<dc:creator><![CDATA[admin]]></dc:creator>
		<content:encoded><![CDATA[<!-- wp:cover {"url":"https://example.com/wp-content/themes/twentytwentyfive/assets/images/coming-soon-bg-image.webp","dimRatio":40,"overlayColor":"contrast","minHeight":100,"minHeightUnit":"vh","align":"full","className":"is-style-a8csp-cover-bg-crossfade","layout":{"type":"constrained"}} -->
<div class="wp-block-cover alignfull is-style-a8csp-cover-bg-crossfade" style="min-height:100vh"><img class="wp-block-cover__image-background" alt="" src="https://example.com/wp-content/themes/twentytwentyfive/assets/images/coming-soon-bg-image.webp" data-object-fit="cover"/><span aria-hidden="true" class="wp-block-cover__background has-contrast-background-color has-background-dim-40 has-background-dim"></span><div class="wp-block-cover__inner-container"><!-- wp:heading {"level":1,"style":{"typography":{"textAlign":"center"}}} -->
<h1 class="wp-block-heading has-text-align-center">Cover Background Crossfade</h1>
<!-- /wp:heading -->

<!-- wp:paragraph {"style":{"typography":{"textAlign":"center"}}} -->
<p class="has-text-align-center">Each Cover block on this page uses the Crossfade Background style. Scroll down.</p>
<!-- /wp:paragraph --></div></div>
<!-- /wp:cover -->

<!-- wp:cover {"url":"https://example.com/wp-content/themes/twentytwentyfive/assets/images/northern-buttercups-flowers.webp","dimRatio":40,"overlayColor":"contrast","minHeight":100,"minHeightUnit":"vh","align":"full","className":"is-style-a8csp-cover-bg-crossfade","layout":{"type":"constrained"}} -->
<div class="wp-block-cover alignfull is-style-a8csp-cover-bg-crossfade" style="min-height:100vh"><img class="wp-block-cover__image-background" alt="" src="https://example.com/wp-content/themes/twentytwentyfive/assets/images/northern-buttercups-flowers.webp" data-object-fit="cover"/><span aria-hidden="true" class="wp-block-cover__background has-contrast-background-color has-background-dim-40 has-background-dim"></span><div class="wp-block-cover__inner-container"><!-- wp:heading {"style":{"typography":{"textAlign":"center"}}} -->
<h2 class="wp-block-heading has-text-align-center">Backgrounds fill the screen</h2>
<!-- /wp:heading -->

<!-- wp:paragraph {"style":{"typography":{"textAlign":"center"}}} -->
<p class="has-text-align-center">The background of the cover nearest the top of the window is shown behind the page.</p>
<!-- /wp:paragraph --></div></div>
<!-- /wp:cover -->

<!-- wp:cover {"url":"https://example.com/wp-content/themes/twentytwentyfive/assets/images/grid-flower-1.webp","dimRatio":40,"overlayColor":"contrast","minHeight":100,"minHeightUnit":"vh","align":"full","className":"is-style-a8csp-cover-bg-crossfade","layout":{"type":"constrained"}} -->
<div class="wp-block-cover alignfull is-style-a8csp-cover-bg-crossfade" style="min-height:100vh"><img class="wp-block-cover__image-background" alt="" src="https://example.com/wp-content/themes/twentytwentyfive/assets/images/grid-flower-1.webp" data-object-fit="cover"/><span aria-hidden="true" class="wp-block-cover__background has-contrast-background-color has-background-dim-40 has-background-dim"></span><div class="wp-block-cover__inner-container"><!-- wp:heading {"style":{"typography":{"textAlign":"center"}}} -->
<h2 class="wp-block-heading has-text-align-center">They crossfade as you scroll</h2>
<!-- /wp:heading -->

<!-- wp:paragraph {"style":{"typography":{"textAlign":"center"}}} -->
<p class="has-text-align-center">When the next cover reaches the top of the window, its background fades in.</p>
<!-- /wp:paragraph --></div></div>
<!-- /wp:cover -->

<!-- wp:cover {"url":"https://example.com/wp-content/themes/twentytwentyfive/assets/images/botany-flowers.webp","dimRatio":40,"overlayColor":"contrast","minHeight":100,"minHeightUnit":"vh","align":"full","className":"is-style-a8csp-cover-bg-crossfade","layout":{"type":"constrained"}} -->
<div class="wp-block-cover alignfull is-style-a8csp-cover-bg-crossfade" style="min-height:100vh"><img class="wp-block-cover__image-background" alt="" src="https://example.com/wp-content/themes/twentytwentyfive/assets/images/botany-flowers.webp" data-object-fit="cover"/><span aria-hidden="true" class="wp-block-cover__background has-contrast-background-color has-background-dim-40 has-background-dim"></span><div class="wp-block-cover__inner-container"><!-- wp:heading {"style":{"typography":{"textAlign":"center"}}} -->
<h2 class="wp-block-heading has-text-align-center">Scroll back up</h2>
<!-- /wp:heading -->

<!-- wp:paragraph {"style":{"typography":{"textAlign":"center"}}} -->
<p class="has-text-align-center">The earlier backgrounds fade back in.</p>
<!-- /wp:paragraph --></div></div>
<!-- /wp:cover -->]]></content:encoded>
