{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Counter",
		"description": "Animated Counter blocks with text before and after the number, different durations, a count-down and counters inside sentences.",
		"author": "WordPress Special Projects Team",
		"categories": [ "Block" ]
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"login": true,
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/a8cteam51/special-projects-blocks-monorepo/releases/download/counter%400.1.3/counter.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installTheme",
			"themeData": {
				"resource": "wordpress.org/themes",
				"slug": "twentytwentyfive"
			},
			"ifAlreadyInstalled": "skip",
			"options": {
				"activate": true
			}
		},
		{
			"step": "importWxr",
			"file": {
				"resource": "bundled",
				"path": "sample-content.xml"
			}
		},
		{
			"step": "setSiteOptions",
			"options": {
				"show_on_front": "page",
				"page_on_front": "1001"
			}
		}
	]
}
