{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "a8csp/bp-groups-progress",
	"version": "0.1.0",
	"title": "Progress Bar",
	"category": "widgets",
	"icon": "ellipsis",
	"description": "Add progress bar for BP Groups.",
	"example": {},
	"usesContext": [ "postId", "postType" ],
	"attributes": {
		"showProgressText": {
			"type": "boolean",
			"default": true
		},
		"progressText": {
			"type": "string",
			"default": "Progress"
		}
	},
	"supports": {
		"html": false,
		"color": {
			"text": true,
			"background": false
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true,
			"textAlign": true
		}
	},
	"textdomain": "bp-groups-progress",
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"render": "file:./render.php"
}
