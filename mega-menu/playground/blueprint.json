{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"meta": {
		"title": "Mega Menu",
		"description": "Two Mega Menu items in the Twenty Twenty-Five header navigation, one opening on click and one on hover, each showing a template part from the Mega Menu area.",
		"author": "WordPress Special Projects Team",
		"categories": [ "Block" ]
	},
	"landingPage": "/",
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"login": true,
	"steps": [
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/a8cteam51/special-projects-blocks-monorepo/releases/download/mega-menu%400.3.0/mega-menu.zip"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installTheme",
			"themeData": {
				"resource": "wordpress.org/themes",
				"slug": "twentytwentyfive"
			},
			"ifAlreadyInstalled": "skip",
			"options": {
				"activate": true
			}
		},
		{
			"step": "importWxr",
			"file": {
				"resource": "bundled",
				"path": "sample-content.xml"
			}
		},
		{
			"step": "setSiteOptions",
			"options": {
				"show_on_front": "page",
				"page_on_front": "1001"
			}
		}
	]
}
