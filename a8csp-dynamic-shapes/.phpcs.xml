<?xml version="1.0"?>
<ruleset xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="vendor/squizlabs/php_codesniffer/phpcs.xsd">
	<!-- Extend the RAL ruleset. -->
	<rule ref="vendor/a8cteam51/team51-configs/quality-assurance/phpcs.dist.xml"/>

	<!-- Check that the proper text domain(s) is used everywhere. -->
	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="a8csp-dynamic-shapes"/> <!-- Change this value to your plugin slug. -->
			</property>
		</properties>
	</rule>

	<!-- Check that the proper prefix is used everywhere. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="a8csp_dynamic_shapes"/>
				<element value="A8CSPDynamicShapes"/>
				<element value="wpcomsp_blocks"/>
			</property>
		</properties>
	</rule>

	<!-- Exclude shared self-update class from commenting rules. -->
	<rule ref="Squiz.Commenting.ClassComment.Missing">
		<exclude-pattern>classes/class-wpcomsp-blocks-self-update.php</exclude-pattern>
	</rule>
	<rule ref="Squiz.Commenting.VariableComment.Missing">
		<exclude-pattern>classes/class-wpcomsp-blocks-self-update.php</exclude-pattern>
	</rule>
</ruleset>
