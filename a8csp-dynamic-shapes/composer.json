{
  "name": "a8cteam51/a8csp-dynamic-shapes",
  "type": "wordpress-plugin",
  "description": "Extends the core Group, Cover, Image, and Featured Image blocks with controls for adjusting corners to create unique shapes.",
  "license": "GPL-2.0-or-later",
  "authors": [
    {
      "name": "Contributors",
      "homepage": "https://github.com/a8cteam51/special-projects-blocks-monorepo/graphs/contributors"
    }
  ],

  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/a8cteam51/team51-configs"
    }
  ],
  "require": {
    "php": ">=7.4",
    "ext-json": "*"
  },
  "require-dev": {
    "a8cteam51/team51-configs": "dev-trunk",
    "wp-cli/i18n-command": "^2.6",
    "roave/security-advisories": "dev-latest"
  },

  "scripts": {
    "format:php": "phpcbf --standard=.phpcs.xml --basepath=. ./ -v",
    "lint:php": [
      "@lint:php:phpcs",
      "@lint:php:phpmd",
      "@lint:php:phpstan"
    ],
    "lint:php:phpcs": "phpcs --standard=.phpcs.xml --basepath=. ./ -v",
    "lint:php:phpmd": "php -d error_reporting=24575 vendor/bin/phpmd ./ ansi ./.phpmd.xml -v",
    "lint:php:phpstan": "phpstan analyse -c ./.phpstan.neon -v --memory-limit=1G",

    "makepot": "wp i18n make-pot . languages/a8csp-dynamic-shapes.pot",
    "updatepo": "wp i18n update-po languages/a8csp-dynamic-shapes.pot",
    "makemo": "wp i18n make-mo languages",
    "internationalize": [
      "@makepot",
      "@updatepo"
    ],

    "packages-install": "@composer install --ignore-platform-reqs --no-interaction",
    "packages-update": [
      "@composer clear-cache",
      "@composer update --prefer-stable --ignore-platform-reqs --no-interaction"
    ]
  },
  "config": {
    "allow-plugins": {
      "composer/*": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
