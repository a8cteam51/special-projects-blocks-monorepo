  <item>
    <title><![CDATA[Dynamic Shapes]]></title>
    <dc:creator><![CDATA[admin]]></dc:creator>
    <content:encoded><![CDATA[<!-- wp:paragraph -->
<p>Each block below has corners pushed in or out from the Dynamic Shape panel in the Styles tab of the block sidebar. Select one and open that panel to change its shape.</p>
<!-- /wp:paragraph -->

<!-- wp:image {"id":2001,"sizeSlug":"full","linkDestination":"none","dynamicShape":{"vtr":"70px","vbl":"50px"}} -->
<figure class="wp-block-image size-full"><img src="https://example.com/wp-content/uploads/playground/botany-flowers.webp" alt="White flowers and leaves" class="wp-image-2001"/></figure>
<!-- /wp:image -->

<!-- wp:group {"dynamicShape":{"vtl":"40px","vbr":"60px"},"backgroundColor":"accent-3","textColor":"base","style":{"spacing":{"padding":{"top":"var:preset|spacing|50","bottom":"var:preset|spacing|50","left":"var:preset|spacing|50","right":"var:preset|spacing|50"}}},"layout":{"type":"constrained"}} -->
<div class="wp-block-group has-base-color has-accent-3-background-color has-text-color has-background" style="padding-top:var(--wp--preset--spacing--50);padding-right:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--50)"><!-- wp:heading -->
<h2 class="wp-block-heading">A shaped Group block</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>The background follows the shape, and the padding grows with the corner offsets so the text isn't clipped.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:group -->

<!-- wp:image {"id":2002,"sizeSlug":"full","linkDestination":"none","dynamicShape":{"vtl":"60px","htr":"60px","vbr":"40px"}} -->
<figure class="wp-block-image size-full"><img src="https://example.com/wp-content/uploads/playground/northern-buttercups-flowers.webp" alt="A yellow buttercup flower" class="wp-image-2002"/></figure>
<!-- /wp:image -->

<!-- wp:group {"dynamicShape":{"htl":"50px","vtr":"50px","hbr":"30px"},"backgroundColor":"contrast","textColor":"base","style":{"spacing":{"padding":{"top":"var:preset|spacing|50","bottom":"var:preset|spacing|50","left":"var:preset|spacing|50","right":"var:preset|spacing|50"}}},"layout":{"type":"constrained"}} -->
<div class="wp-block-group has-base-color has-contrast-background-color has-text-color has-background" style="padding-top:var(--wp--preset--spacing--50);padding-right:var(--wp--preset--spacing--50);padding-bottom:var(--wp--preset--spacing--50);padding-left:var(--wp--preset--spacing--50)"><!-- wp:heading -->
<h2 class="wp-block-heading">Vertical and horizontal insets</h2>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p>Each corner can move vertically, horizontally, or both, using your theme's spacing presets or custom pixel values.</p>
<!-- /wp:paragraph --></div>
<!-- /wp:group -->]]></content:encoded>
